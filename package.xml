<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sas_robot_driver_unitree_g1</name>
  <version>0.0.0</version>
  <description>SmartArmStack driver of the Unitree G1 (29 DoF) in high-level control, following the legged robot driver standard of sas_tools (floating base with five limbs).</description>
  <maintainer email="juanjqogm@gmail.com">s55322jq</maintainer>
  <license>LGPL-2.1-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sas_core</depend>
  <depend>sas_common</depend>
  <depend>sas_robot_driver</depend>
  <depend>sas_tools</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
